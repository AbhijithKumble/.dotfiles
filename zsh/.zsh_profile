export RPM_ARCH=$(uname -m)
export PYTHONPATH=/usr/local/lib/python3.13/dist-packages:$PYTHONPATH
export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
export XDG_CONFIG_HOME=$HOME/.config
VIM="nvim"
alias vi="nvim"

