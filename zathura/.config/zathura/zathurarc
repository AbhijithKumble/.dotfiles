# Use the poppler PDF backend (recommended for LaTeX documents)
set pdf-poppler

# Enable SyncTeX (enables forward and reverse search)
set synctex true

# Set the editor for reverse search (should be `vim` or `nvim` for Neovim)
set editor nvim

# Set the LaTeX PDF viewer (useful if you want to handle PDFs with a specific backend)
set pdf-viewer true

# Define the search command (optional)
set completion-cmd "fzf"  # If you use fzf for fuzzy searching

# Enable mouse support (optional, remove if not needed)
set mouse-enabled true

# Enable zooming with mouse scroll (optional)
set zoom 1

# Adjust the default page layout (single page or two columns)
set page-layout single

# Customize the color scheme (optional)
set recolor true
set recolor-boost 0.5
set recolor-darkcolor "#282828"
set recolor-lightcolor "#f0f0f0"

